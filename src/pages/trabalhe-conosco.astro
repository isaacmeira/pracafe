---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import FormPlaceholder from '../components/FormPlaceholder.astro';
const vagas = [
  { titulo: 'Costureiro(a) industrial', area: 'Produção', icone: 'lucide:scissors' },
  { titulo: 'Embalador(a)', area: 'Expedição', icone: 'lucide:package' },
  { titulo: 'Motorista carreteiro', area: 'Logística', icone: 'lucide:truck' },
];
---
<Base title="Trabalhe conosco" description="Vagas na PraCafé Embalagens em Manhuaçu-MG: costura industrial, embalagem e logística. Envie seu currículo.">
  <section class="container-x pt-32 pb-12 sm:pt-40">
    <SectionHead as="h1" eyebrow="Carreiras" title="Vagas e banco de currículos." text="A PraCafé abre vagas de produção, expedição e logística em Manhuaçu-MG. Confira as oportunidades ou deixe seu currículo." />
  </section>
  <section class="container-x pb-20 sm:pb-28 grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-4 space-y-4" data-stagger="100">
      <p class="eyebrow text-verde-600" data-reveal="up">Vagas abertas</p>
      {vagas.map((v) => <div class="card p-6 flex items-center gap-4" data-reveal="up"><span class="size-12 rounded-md bg-verde-900 text-verde-300 grid place-items-center shrink-0"><Icon name={v.icone} class="size-6" /></span><span><span class="eyebrow text-grafite-500 block">{v.area}</span><span class="font-display font-bold text-lg text-verde-900">{v.titulo}</span></span></div>)}
      <p class="text-xs text-grafite-500" data-reveal="up">Manhuaçu-MG · presencial</p>
    </div>
    <div class="lg:col-span-8"><FormPlaceholder tipo="curriculo" titulo="Banco de currículos" /></div>
  </section>
</Base>

