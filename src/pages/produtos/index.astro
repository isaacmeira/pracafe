---
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import CTA from '../../components/CTA.astro';
import { categorias } from '../../data/produtos';
const total = categorias.reduce((n, c) => n + c.produtos.length, 0);
---
<Base title="Produtos" description="Catálogo completo PraCafé: big bags, sacaria de ráfia, sacos impressos, panos e lonas de colheita, barbantes e fitilhos, marca própria, tecidos de ráfia, fios e acessórios.">
  <section class="container-x pt-32 pb-12 sm:pt-40">
    <SectionHead as="h1" eyebrow={`${categorias.length} famílias · ${total} produtos`} title="Catálogo de embalagens de ráfia." text="Cada ficha traz medidas, gramaturas, capacidades e opções de personalização. Outras medidas são fabricadas sob encomenda." />
    <nav class="mt-10 flex flex-wrap gap-2" aria-label="Categorias" data-stagger="50">
      {categorias.map((c) => <a href={`#${c.slug}`} class="inline-flex items-center gap-2 rounded-full border border-verde-900/15 px-4 py-2 text-sm font-medium hover:bg-verde-900 hover:text-areia-50 transition-colors" data-reveal="up"><Icon name={c.icone} class="size-4" />{c.nome}</a>)}
    </nav>
  </section>

  {categorias.map((c, i) => (
    <section id={c.slug} class:list={['py-16 sm:py-20 scroll-mt-24', i % 2 ? 'bg-areia-100' : '']}>
      <div class="container-x">
        <div class="grid gap-8 lg:grid-cols-12 items-end mb-10">
          <div class="lg:col-span-7 flex items-start gap-5">
            <span class="size-14 shrink-0 rounded-md bg-verde-900 text-verde-300 grid place-items-center" data-reveal="scale"><Icon name={c.icone} class="size-7" /></span>
            <div>
              <p class="eyebrow text-verde-600 mb-2" data-reveal="up">Família 0{i + 1}</p>
              <h2 class="display-md text-verde-900" data-split="words">{c.nome}</h2>
              <p class="mt-3 text-grafite-700 max-w-2xl" data-reveal="up">{c.descricao}</p>
            </div>
          </div>
          <div class="lg:col-span-5 lg:text-right" data-reveal="up"><a href={`/produtos/${c.slug}`} class="btn-ghost text-verde-900">Página da família <Icon name="lucide:arrow-right" class="size-5" /></a></div>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" data-stagger="80">
          {c.produtos.map((p) => <ProdutoCard produto={p} categoria={c} />)}
        </div>
      </div>
    </section>
  ))}

  <CTA />
</Base>
