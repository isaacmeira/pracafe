---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import CategoriaCard from '../components/CategoriaCard.astro';
import AplicacaoCard from '../components/AplicacaoCard.astro';
import BigBagConfigurador from '../components/BigBagConfigurador.astro';
import CTA from '../components/CTA.astro';
import { site, waLink, mercados, numeros, aplicacoes } from '../data/site';
import { categorias } from '../data/produtos';

const pilares = [
  { icone: 'lucide:ruler-dimension-line', titulo: 'Fabricação sob medida', texto: 'Medida, gramatura, cor e capacidade definidas pelo cliente. Sacaria em até 6 cores e big bag em até 3 cores de impressão.' },
  { icone: 'lucide:shield-check', titulo: 'Fator de segurança especificado', texto: 'Big bags reutilizáveis 6:1 e descartáveis 5:1. Linha com certificação UN para cargas perigosas.' },
  { icone: 'lucide:tractor', titulo: 'Indústria na região produtora', texto: 'Fábrica em Manhuaçu-MG, nas Matas de Minas, desde 2004. Produtos desenvolvidos com cafeicultores e armazéns da região.' },
  { icone: 'lucide:truck', titulo: 'Atendimento em MG, ES, BA e RJ', texto: 'Entrega para produtores, cooperativas, armazéns e revendas em Minas Gerais, Espírito Santo, Bahia e Rio de Janeiro.' },
];

const passos = [
  { n: '01', icone: 'lucide:sprout', titulo: 'Colheita', texto: 'Panos derriçadores de até 30 m recebem o café. Sacaria BC com faixa de medida dispensa o balaio.' },
  { n: '02', icone: 'lucide:shopping-bag', titulo: 'Ensacamento', texto: 'Sacos de ráfia reforçados, reutilizáveis por várias safras, com luvas e alças de peneira da marca própria.' },
  { n: '03', icone: 'lucide:package', titulo: 'Big bag', texto: 'Do saco ao contentor flexível: 500 a 2.000 kg por unidade, com modelos C1 a C6 para cada tipo de descarga.' },
  { n: '04', icone: 'lucide:forklift', titulo: 'Movimentação', texto: 'Alças dimensionadas para muck e empilhadeira reduzem tempo de carga e perdas por rompimento.' },
  { n: '05', icone: 'lucide:warehouse', titulo: 'Armazém e exportação', texto: 'Modelo cubo economiza até 30% do espaço em contêiner. Porta ensacado substitui o palete.' },
];

const fotos = [
  { src: '/img/aplicacoes/cafeicultura/20120525colheita.jpg', alt: 'Colheita de café com pano de ráfia', span: 'sm:col-span-2 sm:row-span-2' },
  { src: '/img/aplicacoes/cafeicultura/big-bag-colheita.jpg', alt: 'Big bag de colheita na lavoura' },
  { src: '/img/hero/colheita-bigbag.jpg', alt: 'Big bag com frutas colhidas' },
  { src: '/img/aplicacoes/revenda/saco-rafia-6.jpg', alt: 'Sacos de ráfia empilhados' },
  { src: '/img/produtos/9/b_a5.jpg', alt: 'Big bags Pra Café' },
  { src: '/img/aplicacoes/revenda/pano-colheita-cafe.jpg', alt: 'Pano de colheita de café' },
  { src: '/img/aplicacoes/cafeicultura/bag-cafe.jpg', alt: 'Big bag de café' },
];
---
<Base title={site.nome} dark>
  <!-- ===================== HERO ===================== -->
  <section class="relative min-h-[100svh] bg-verde-950 text-areia-50 overflow-hidden grain" data-parallax-root>
    <div class="absolute inset-0 weave opacity-70"></div>

    <div class="container-x relative pt-32 pb-16 lg:pt-40 lg:pb-24 grid gap-14 lg:grid-cols-12 items-center min-h-[100svh]">
      <div class="lg:col-span-7">
        <h1 class="display-xl" data-split="words">Embalagens de ráfia para a colheita, o armazém e a indústria.</h1>
        <p class="mt-7 max-w-xl text-lg sm:text-xl text-areia-100/75 leading-relaxed" data-reveal="up" data-reveal-delay="500">
          Big bags, sacaria, panos de colheita, fitilhos e tecidos de polipropileno fabricados em Manhuaçu-MG desde 2004. Venda direta da indústria, em qualquer medida.
        </p>
        <div class="mt-9 flex flex-col sm:flex-row gap-3" data-stagger="120">
          <a href={waLink()} target="_blank" rel="noopener" class="btn-primary" data-reveal="up" data-reveal-delay="650"><Icon name="tabler:brand-whatsapp" class="size-5" /> Pedir orçamento</a>
          <a href="/produtos" class="btn-ghost" data-reveal="up" data-reveal-delay="650"><Icon name="lucide:package" class="size-5" /> Ver catálogo de produtos</a>
        </div>
        <ul class="mt-14 grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-6 max-w-3xl border-t border-white/10 pt-8" data-stagger="100">
          {[
            ['lucide:weight', 'Até 2.000 kg', 'por big bag'],
            ['lucide:printer-check', '6 cores', 'de impressão'],
            ['lucide:badge-check', 'Certificação UN', 'cargas perigosas'],
            ['lucide:sun', 'Aditivo UV', 'resistência ao tempo'],
          ].map(([ic, a, b]) => (
            <li class="flex items-center gap-3.5" data-reveal="up" data-reveal-delay="900">
              <span class="size-11 shrink-0 rounded-md bg-white/6 ring-1 ring-white/10 grid place-items-center text-verde-300"><Icon name={ic} class="size-5" /></span>
              <span class="leading-tight min-w-0"><span class="block font-display font-semibold text-[15px] whitespace-nowrap">{a}</span><span class="block text-xs text-white/60 mt-0.5">{b}</span></span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Cena SVG: big bag sendo preenchido -->
      <div id="hero-scene" class="lg:col-span-5 relative mx-auto w-full max-w-[460px] aspect-[4/5]">
        <svg viewBox="0 0 400 500" class="absolute inset-0 size-full overflow-visible" aria-hidden="true">
          <defs>
            <linearGradient id="hb-fabric" x1="0" x2="1" y1="0" y2="1">
              <stop offset="0" stop-color="#efede6" /><stop offset="1" stop-color="#e1ddd0" />
            </linearGradient>
            <pattern id="hb-weave" width="10" height="10" patternUnits="userSpaceOnUse">
              <path d="M0 5h10M5 0v10" stroke="#23402a" stroke-opacity="0.08" stroke-width="1.5" />
            </pattern>
            <clipPath id="hb-round"><circle cx="200" cy="335" r="50" /></clipPath>
            <clipPath id="hb-clip"><path d="M70 150 Q70 120 100 120 H300 Q330 120 330 150 V420 Q330 460 290 460 H110 Q70 460 70 420 Z" /></clipPath>
          </defs>
          <g id="hb-group">
            <!-- alças -->
            <path class="hb-strap" d="M100 125 C90 60 130 40 140 40 C150 40 160 70 150 125" fill="none" stroke="#47784f" stroke-width="12" stroke-linecap="round" />
            <path class="hb-strap" d="M250 125 C240 60 280 40 290 40 C300 40 310 70 300 125" fill="none" stroke="#47784f" stroke-width="12" stroke-linecap="round" />
            <!-- corpo -->
            <g id="hb-body" style="transform-box: fill-box; transform-origin: 50% 100%">
              <path d="M70 150 Q70 120 100 120 H300 Q330 120 330 150 V420 Q330 460 290 460 H110 Q70 460 70 420 Z" fill="url(#hb-fabric)" />
              <path d="M70 150 Q70 120 100 120 H300 Q330 120 330 150 V420 Q330 460 290 460 H110 Q70 460 70 420 Z" fill="url(#hb-weave)" />
              <!-- costuras -->
              <path d="M85 135 V440 M315 135 V440 M200 125 V455" stroke="#23402a" stroke-opacity="0.15" stroke-dasharray="6 6" stroke-width="2" />
              <!-- preenchimento (café) -->
              <g clip-path="url(#hb-clip)">
                <rect id="hb-fill" x="70" y="120" width="260" height="340" fill="#4a3527" style="transform-box: fill-box; transform-origin: 50% 100%" />
                <rect x="70" y="120" width="260" height="340" fill="url(#hb-weave)" opacity="0.6" style="mix-blend-mode: multiply" />
              </g>
              <!-- selo com a logo redonda -->
              <circle cx="200" cy="335" r="56" fill="#f8f7f3" />
              <image href="/img/brand/icon-192.png" x="150" y="285" width="100" height="100" clip-path="url(#hb-round)" preserveAspectRatio="xMidYMid slice" />
            </g>
            <!-- grãos -->
            {Array.from({ length: 14 }).map((_, i) => {
              const x = 105 + (i * 37) % 200; const y = 70 + (i % 4) * 14; const r = i % 3 === 0 ? 11 : 9;
              return <g class="hb-bean" style={`transform-box: fill-box; transform-origin: center`}><ellipse cx={x} cy={y} rx={r} ry={r * 1.5} fill="#4a3527" transform={`rotate(${(i * 23) % 60 - 30} ${x} ${y})`} /><path d={`M${x} ${y - r * 1.2} Q${x + 3} ${y} ${x} ${y + r * 1.2}`} stroke="#2f211a" stroke-width="2" fill="none" transform={`rotate(${(i * 23) % 60 - 30} ${x} ${y})`} /></g>;
            })}
          </g>
        </svg>
        <!-- tags flutuantes -->
        <div class="hb-tag absolute -left-2 top-[38%] card !bg-white px-3.5 py-2.5 shadow-lift text-verde-900 flex items-center gap-2 text-sm font-semibold"><Icon name="lucide:weight" class="size-4 text-verde-600" /> Até 2.000 kg</div>
        <div class="hb-tag absolute -right-2 top-[26%] card !bg-white px-3.5 py-2.5 shadow-lift text-verde-900 flex items-center gap-2 text-sm font-semibold"><Icon name="lucide:shield-check" class="size-4 text-verde-600" /> Fator 6:1</div>
        <div class="hb-tag absolute right-4 bottom-[8%] card !bg-cereja-500 !border-cereja-500 px-3.5 py-2.5 shadow-lift text-white flex items-center gap-2 text-sm font-semibold"><Icon name="lucide:sun" class="size-4" /> Aditivo UV</div>
        <div class="hb-tag absolute left-6 bottom-[16%] card !bg-white px-3.5 py-2.5 shadow-lift text-verde-900 flex items-center gap-2 text-sm font-semibold"><Icon name="lucide:ruler" class="size-4 text-verde-600" /> Sob medida</div>
      </div>
    </div>

  </section>

  <!-- ===================== MARQUEE ===================== -->
  <section id="mercados" class="bg-verde-800 text-white py-4 overflow-hidden marquee" aria-label="Mercados atendidos">
    <div class="marquee-track flex w-max gap-10 whitespace-nowrap font-display font-bold text-xl sm:text-2xl uppercase tracking-tight">
      {[...mercados, ...mercados].map((m) => <span class="inline-flex items-center gap-10"><span>{m}</span><span class="size-1.5 rounded-full bg-cereja-400"></span></span>)}
    </div>
  </section>

  <!-- ===================== NÚMEROS ===================== -->
  <section class="container-x py-20 sm:py-28">
    <div class="grid gap-10 lg:grid-cols-12 items-end">
      <SectionHead class="lg:col-span-5" eyebrow="A PraCafé em números" title="Indústria de embalagens em Manhuaçu-MG desde 2004." text="Fabricamos e comercializamos embalagens de polipropileno (ráfia) para cafeicultores, agroindústria, armazéns gerais, indústrias e revendas." />
      <ul class="lg:col-span-7 grid grid-cols-2 md:grid-cols-3 gap-4" data-stagger="90">
        {numeros.map((n, i) => (
          <li class:list={['card p-6 flex flex-col gap-1', i === 0 && 'col-span-2 md:col-span-1 bg-verde-900 text-areia-50 !ring-0']} data-reveal="up">
            <span class:list={['font-display font-bold tracking-tight text-4xl sm:text-5xl', i === 0 ? 'text-verde-300' : 'text-verde-900']} data-count={n.valor} data-suffix={n.sufixo}>0</span>
            <span class="font-semibold">{n.label}</span>
            <span class:list={['text-xs', i === 0 ? 'text-areia-100/60' : 'text-grafite-500']}>{n.detalhe}</span>
          </li>
        ))}
        <li class="card p-6 flex items-center justify-center bg-verde-300 !ring-0 text-verde-950" data-reveal="up">
          <a href="/empresa" class="font-display font-bold text-lg inline-flex items-center gap-2 hover:gap-3 transition-[gap]">Conheça a empresa <Icon name="lucide:arrow-right" class="size-5" /></a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ===================== CATEGORIAS ===================== -->
  <section class="relative bg-areia-100 py-20 sm:py-28 overflow-hidden">
    <div class="container-x relative">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <SectionHead eyebrow="Produtos" title="Oito linhas de embalagens e acessórios." />
        <a href="/produtos" class="btn-dark shrink-0" data-reveal="up"><Icon name="lucide:layers" class="size-5" /> Catálogo completo</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-stagger="80" style="perspective: 1200px">
        {categorias.map((c, i) => <CategoriaCard categoria={c} index={i} />)}
      </div>
    </div>
  </section>

  <!-- ===================== PROCESSO ===================== -->
  <section class="relative bg-verde-900 text-white py-20 sm:py-28 overflow-hidden">
    <div class="absolute inset-0 weave opacity-60"></div>
    <div class="container-x relative">
      <div class="grid gap-8 lg:grid-cols-12 items-end mb-14">
        <SectionHead light class="lg:col-span-7" eyebrow="Da lavoura ao armazém" title="Uma embalagem para cada etapa da carga." text="Do pano de colheita ao big bag no contêiner: o que a PraCafé fornece em cada etapa." />
        <div class="lg:col-span-5 lg:text-right" data-reveal="up">
          <a href="/aplicacoes/cafeicultura" class="btn-ghost">Ver solução para cafeicultura <Icon name="lucide:arrow-right" class="size-5" /></a>
        </div>
      </div>
      <ol class="relative grid gap-8 sm:grid-cols-2 lg:grid-cols-5" data-stagger="120">
        <div class="hidden lg:block absolute left-0 right-0 top-7 h-px bg-white/15" aria-hidden="true"><div class="h-full bg-verde-300 origin-left" data-progress-scale></div></div>
        {passos.map((p) => (
          <li class="relative lg:pt-20" data-reveal="up">
            <span class="size-14 rounded-md bg-verde-800 border border-white/15 grid place-items-center text-verde-300 lg:absolute lg:top-0 lg:left-0"><Icon name={p.icone} class="size-6" /></span>
            <p class="font-mono text-xs text-verde-300 mt-5 lg:mt-0">{p.n}</p>
            <h3 class="font-display font-bold text-xl mt-1">{p.titulo}</h3>
            <p class="text-sm text-white/70 leading-relaxed mt-2">{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ===================== APLICAÇÕES ===================== -->
  <section class="container-x py-20 sm:py-28">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <SectionHead eyebrow="Aplicações" title="Produtos indicados por segmento." text="Selecione o seu mercado para ver os produtos recomendados, com medidas e gramaturas de referência." />
      <a href="/aplicacoes" class="btn-ghost text-verde-900 shrink-0" data-reveal="up">Todas as aplicações <Icon name="lucide:arrow-right" class="size-5" /></a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-stagger="100">
      <div class="lg:row-span-2"><AplicacaoCard app={aplicacoes[0]} tall /></div>
      {aplicacoes.slice(1, 5).map((a) => <AplicacaoCard app={a} />)}
      <a href="/revendedores" class="group relative overflow-hidden rounded-lg bg-verde-700 text-white p-7 flex flex-col justify-between min-h-[300px]" data-reveal="scale">
        <Icon name="lucide:store" class="size-10" />
        <div>
          <h3 class="font-display font-bold text-2xl tracking-tight">Revendedores e distribuidores</h3>
          <p class="mt-2 text-sm text-white/80 max-w-xs">Condições de atacado, marca própria e entrega em MG, ES, BA e RJ para agropecuárias e atacadistas.</p>
          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold">Quero revender <Icon name="lucide:arrow-right" class="size-4 transition-transform group-hover:translate-x-1" /></span>
        </div>
      </a>
    </div>
  </section>

  <!-- ===================== CONFIGURADOR ===================== -->
  <section class="relative bg-areia-100 py-20 sm:py-28 overflow-hidden">
    <div class="container-x">
      <SectionHead align="center" eyebrow="Configurações de big bag" title="Seis modelos, cinco tipos de alça, quatro bocas e sete fundos." text="Enchimento, descarga, alças e liner são combinados conforme o produto e o equipamento do cliente. Tecido, costura e fator de segurança são dimensionados pela equipe técnica." class="mb-14" />
      <BigBagConfigurador compact />
      <div class="mt-10 flex justify-center" data-reveal="up">
        <a href="/produtos/big-bags" class="btn-dark">Ver todas as opções de alças, bocas e fundos <Icon name="lucide:arrow-right" class="size-5" /></a>
      </div>
    </div>
  </section>

  <!-- ===================== PILARES ===================== -->
  <section class="container-x py-20 sm:py-28">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5 lg:sticky lg:top-28 self-start">
        <SectionHead eyebrow="Por que a PraCafé" title="Fabricante, não revenda." text="Quem compra da PraCafé fala direto com a fábrica que tece, corta, costura e imprime a embalagem." />
        <svg class="mt-10 w-full max-w-sm text-verde-500" viewBox="0 0 320 120" fill="none" data-draw aria-hidden="true">
          <path d="M10 100 C 60 20, 120 20, 160 60 S 260 110, 310 30" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
          <circle cx="10" cy="100" r="6" stroke="currentColor" stroke-width="3" />
          <circle cx="160" cy="60" r="6" stroke="currentColor" stroke-width="3" />
          <circle cx="310" cy="30" r="6" stroke="currentColor" stroke-width="3" />
          <path d="M10 112 H310" stroke="currentColor" stroke-opacity="0.3" stroke-width="2" stroke-dasharray="4 6" />
        </svg>
      </div>
      <ul class="lg:col-span-7 grid sm:grid-cols-2 gap-4" data-stagger="110">
        {pilares.map((p, i) => (
          <li class="card p-7 flex flex-col gap-4 hover:shadow-lift hover:-translate-y-1 transition-[transform,box-shadow] duration-500" data-reveal="up">
            <span class="size-12 rounded-md bg-verde-900 text-verde-300 grid place-items-center"><Icon name={p.icone} class="size-6" /></span>
            <span class="font-mono text-xs text-grafite-500">0{i + 1}</span>
            <h3 class="font-display font-bold text-xl tracking-tight text-verde-900 -mt-3">{p.titulo}</h3>
            <p class="text-sm text-grafite-700 leading-relaxed">{p.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== GALERIA ===================== -->
  <section class="bg-verde-900 text-areia-50 py-20 sm:py-28 overflow-hidden grain" data-parallax-root>
    <div class="container-x">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <SectionHead light eyebrow="Galeria" title="Produtos em uso na lavoura e no armazém." />
        <a href={site.redes.instagram} target="_blank" rel="noopener" class="btn-ghost shrink-0" data-reveal="up"><Icon name="tabler:brand-instagram" class="size-5" /> @pracafebr</a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 [grid-auto-rows:minmax(140px,auto)] sm:[grid-auto-rows:220px]" data-stagger="80">
        {fotos.map((f, i) => (
          <figure class:list={['relative overflow-hidden rounded-md bg-verde-800', f.span]} data-reveal="scale">
            <img src={f.src} alt={f.alt} loading="lazy" decoding="async" class="size-full object-cover hover:scale-105 transition-transform duration-700 ease-out-expo" data-parallax={i % 2 ? '0.06' : '-0.06'} />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</Base>
