---
import { Icon } from 'astro-icon/components';
import type { Categoria } from '../data/produtos';
interface Props { categoria: Categoria; index: number }
const { categoria, index } = Astro.props;
---
<a href={`/produtos/${categoria.slug}`} class="group card overflow-hidden flex flex-col hover:-translate-y-1 hover:shadow-lift transition-[transform,box-shadow] duration-500 ease-out-expo" data-reveal="up">
  <div class="relative aspect-[4/3] overflow-hidden bg-areia-100">
    <img src={categoria.capa} alt={categoria.nome} loading="lazy" decoding="async" class="size-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-105" />
    <span class="absolute left-4 bottom-4 size-11 rounded-md bg-verde-900 text-verde-300 grid place-items-center shadow-lift"><Icon name={categoria.icone} class="size-5" /></span>
    <span class="absolute right-4 top-4 font-mono text-xs bg-white/90 text-verde-900 rounded-md px-2 py-1">0{index + 1}</span>
  </div>
  <div class="p-5 sm:p-6 flex flex-col flex-1">
    <h3 class="font-display font-bold text-xl tracking-tight text-verde-900">{categoria.nome}</h3>
    <p class="mt-2 text-sm text-grafite-700 leading-relaxed">{categoria.resumo}</p>
    <span class="mt-auto pt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-verde-600 group-hover:text-verde-800">{categoria.produtos.length} {categoria.produtos.length === 1 ? 'produto' : 'produtos'} <Icon name="lucide:arrow-up-right" class="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" /></span>
  </div>
</a>
