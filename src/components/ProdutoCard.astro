---
import { Icon } from 'astro-icon/components';
import type { Produto, Categoria } from '../data/produtos';
interface Props { produto: Produto; categoria: Categoria; delay?: number }
const { produto, categoria } = Astro.props;
---
<a href={`/produtos/${categoria.slug}/${produto.slug}`} class="group card overflow-hidden flex flex-col hover:shadow-lift hover:-translate-y-1 transition-[transform,box-shadow] duration-500 ease-out-expo" data-reveal="up">
  <div class="relative aspect-[4/3] overflow-hidden bg-areia-100">
    <img src={produto.capa} alt={produto.nome} loading="lazy" decoding="async" class="size-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-105" />
    <span class="absolute left-3 top-3 font-mono text-[11px] bg-verde-950/80 text-areia-50 rounded-full px-2.5 py-1 backdrop-blur">COD {produto.codigo}</span>
  </div>
  <div class="p-5 flex flex-col gap-2 flex-1">
    <p class="eyebrow text-verde-600 flex items-center gap-1.5"><Icon name={categoria.icone} class="size-3.5" />{categoria.nome}</p>
    <h3 class="font-display font-semibold text-lg leading-tight text-verde-900">{produto.nome}</h3>
    <p class="text-sm text-grafite-700 leading-relaxed line-clamp-2">{produto.resumo}</p>
    <span class="mt-auto pt-3 inline-flex items-center gap-1 text-sm font-semibold text-verde-900">Ver ficha técnica <Icon name="lucide:arrow-right" class="size-4 transition-transform group-hover:translate-x-1" /></span>
  </div>
</a>
